# Configuración de Entorno - CercaYa Backend

NODE_ENV=development
PORT=3000

# 🗄️ Base de Datos (PostgreSQL + PostGIS)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cercaya
DB_USER=postgres
DB_PASSWORD=tu_contraseña_segura

# 🔐 Seguridad JWT
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=tu_secreto_aleatorio_de_al_menos_64_caracteres
JWT_EXPIRES_IN=15m
# Secreto DIFERENTE al JWT_SECRET para firmar refresh tokens
JWT_REFRESH_SECRET=otro_secreto_aleatorio_de_al_menos_64_caracteres
JWT_REFRESH_EXPIRES_IN=7d

# 🌐 CORS & Red
CORS_ORIGIN=http://localhost:5173

# 🚀 Rate Limiting (Opcional - Valores por defecto en código)
# AUTH_LIMIT_WINDOW_MS=900000 (15 min)
# AUTH_LIMIT_MAX_REQUESTS=10
